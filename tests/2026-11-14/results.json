    },
    {
      "id": "resume-coach",
      "source_commit": "c74119813aa295331e21d07e04cc86a377a16956",
      "status": "partial_parser_and_single_session",
      "summary": "中文诊断单次演练完成；MD/PDF 解析保留检查项。DOCX 解析只读普通段落，漏掉表格中的公司、学校和项目标题，不可直接信任诊断。"
    },
    {
      "id": "repo-to-resume-tailor",
      "source_commit": "6d2f526b15a6e8f6796e5953d48d7130a06def61",
      "status": "single_session_only",
      "summary": "用虚构仓库做一次中文证据演练，区分本人函数与参考模板；不证明真实履历收益或重复执行质量。"
    },
    {
      "id": "resume-builder-cn",
      "source_commit": "82f90483ca06984060848f4521ff7aabc872726a",
      "status": "template_only",
      "summary": "入口 YAML 有效。上游可编辑模板填入同一虚构样例后用 Edge 导出通过；没有执行完整访谈、岗位研究及其原导出脚本。"
    },
    {
      "id": "init-resume-builder",
      "source_commit": "c710c4d7d00b8b245cf7913c9a989a3c1bebae0d",
      "status": "baseline_only_stress_fail",
      "summary": "入口 YAML 有效。样例模板单页通过；多块长文示例分页生成 5 页，7 个压力编号的完整正文不可提取，页面边缘可见裁切。"
    },
    {
      "id": "resume-md2pdf",
      "source_commit": "44c511605b7efbaf9a51715fd15bb7c6c4993a03",
      "status": "conditional",
      "summary": "上游建 HTML 和导出脚本使用 Edge，中文技术词混排样例及 40 条长文通过。上游仍明确不支持混排，不将一次成功扩展为通用支持。"
    },
